{
    // ======================================================================
    // 圣痕洗词缀 V2（智能版）
    //   - 与旧的“正则版” 洗词缀.json 完全独立，互不影响
    //   - 所有 ROI 都是 1280x720 基准分辨率（PC 端务必保持 16:9）
    //
    // 【启动页面 = 重构结果页】
    //   任务要求你先点一次「词缀重构」，停在**重构结果页**（能同时看到
    //   「旧词缀技能 / 新词缀技能」两块面板和「保留旧词缀 / 写入新词缀」按钮）
    //   再开始。理由：
    //     · 那里两块面板都是干净完整的，旧词缀就是“我现在身上的”，判达标/择优最准；
    //     · 主页左下那块「词缀技能」面板显示不全（长词缀被面板截断、锁定的那条
    //       被「已锁定」标记盖住），所以任务根本不读它；
    //     · 能走到结果页本身，就说明你已经在定向重构页点过一次重构，锁肯定设好了。
    //
    // 【循环】结果页 -> 读旧(身上的)+新(候选) -> 旧达标就结束
    //        -> 新的有效总攻击力更高就点「写入新词缀」
    //        -> 否则：普通模式点「再次重构」**原地**换一批（不回主页，快一倍）；
    //                 锁模式没有「再次重构」，只能点「保留旧词缀」
    //        -> 提交（保留/写入）之后游戏一定回主页 -> 点「词缀重构」回结果页 -> 继续
    //
    // 【锁定的那条怎么认】锁定的词缀不会被重构，所以它在旧/新两批里文本完全一样。
    //   逐行比对，只有一条相同 => 那条就是锁定的，同时证明确实锁了一条。
    //
    // 【重要 1】所有按钮节点的 action 都是 Click 且 **不写 target**。
    //   MaaFramework 里 target 默认是 true，意思是“点击本次识别到的 box”。
    //   如果写成 target: [x, y, w, h]，框架会在矩形里 **随机取点**
    //   （官方文档：a random point will be selected within the rectangle），
    //   矩形一大就会点到上面的面板上去。
    // ======================================================================

    "洗词缀V2": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": "Custom",
        "custom_action": "AffixRerollV2",
        // 这里的值是“默认值”，界面上选择的值会通过下面的参数节点覆盖
        "custom_action_param": {
            "模式": "直接洗词缀",
            "确认词缀锁": "No",
            "单条高攻": "Yes",
            "单条达标值": 22.9,
            "属性": "异能",
            "武器": "弓箭、环刃",
            "目标攻击力": 42.0,
            "最大重构次数": 500,
            "重构等待": 2.0,
            "写入等待": 2.0,
            "OCR重试次数": 3,
            "不可靠上限": 8
        },
        "focus": {
            "Node.Action.Starting": "开始智能洗词缀：按有效攻击力在新旧词缀之间择优",
            "Node.Action.Succeeded": "智能洗词缀完成",
            "Node.Action.Failed": "智能洗词缀未达成目标，已停止"
        }
    },

    // ----------------------------------------------------------------------
    // 界面参数载体
    //   每个下拉框/开关/输入框只 override 自己那一个节点的 custom_action_param，
    //   这样多个选项不会互相覆盖。
    //   自定义动作运行时用 context.get_node_data() 把它们读回来。
    // ----------------------------------------------------------------------
    "洗词缀V2-参数-模式": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "直接洗词缀"
    },
    "洗词缀V2-参数-确认词缀锁": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "No"
    },
    "洗词缀V2-参数-单条高攻": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "Yes"
    },
    "洗词缀V2-参数-单条达标值": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "22.9"
    },
    "洗词缀V2-参数-角色属性": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "异能"
    },
    "洗词缀V2-参数-武器类别": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "弓箭、环刃"
    },
    "洗词缀V2-参数-目标总攻击力": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "42"
    },
    "洗词缀V2-参数-重构次数上限": {
        "action": "Custom",
        "custom_action": "AffixRerollV2ParamHolder",
        "custom_action_param": "500"
    },

    // ======================================================================
    // 一、结果页（两种模式共用）
    //     右上角两个大面板，按钮在下方
    // ======================================================================
    "洗词缀V2-识别-旧词缀1": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 168, 615, 84],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-旧词缀2": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 262, 615, 82],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-新词缀1": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 448, 615, 76],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-新词缀2": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 536, 615, 78],
                "expected": []
            }
        }
    },
    // 再次重构：只在【普通重构的结果页】上有（词缀锁的结果页没有这个按钮）。
    // 点它可以在结果页原地换一批新词缀，不用回主页，快得多。
    "洗词缀V2-点击-再次重构": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [190, 606, 238, 114],
                "expected": ["再次\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "post_delay": 200
    },
    // 保留 / 写入：先 OCR 认字，再点文字框正中
    //   实测文字框：「保留旧词缀」x 719..864，「写入新词缀」x 1035..1180，y 646..685
    "洗词缀V2-点击-保留旧词缀": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 630, 210, 72],
                "expected": ["保留\\s*旧\\s*词\\s*缀"]
            }
        },
        "action": "Click",
        "post_delay": 200
    },
    "洗词缀V2-点击-写入新词缀": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1016, 630, 210, 72],
                "expected": ["写入\\s*新\\s*词\\s*缀"]
            }
        },
        "action": "Click",
        "post_delay": 200
    },

    // ======================================================================
    // 二、主页标记 + 重投按钮
    //     任务本身从【重构结果页】启动；只有「保留/写入」之后游戏会强制回到主页，
    //     这时用这些标记确认人确实回到了主页，再点「词缀重构」回结果页。
    //     （主页左下那块「词缀技能」面板显示不全 —— 词缀名一长就被面板自己截掉，
    //       定向重构页上锁定的那条还会被游戏自己的「已锁定」标记盖住；
    //       所以任务**不读**它，只拿它当“人在主页”的标记）
    // ======================================================================
    "洗词缀V2-主页-验证-词缀技能面板": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [45, 470, 200, 40],
                "expected": ["词缀技能"]
            }
        }
    },

    // ======================================================================
    // 三、普通重构页（模式：直接洗词缀）
    //     主页说明文字是「重新生成2个词缀技能…」（注意：这和词缀锁页的不一样）
    //     右下角有两个按钮：词缀重构 / 十次重构
    // ======================================================================
    "洗词缀V2-普通-验证-培养预览": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 360, 495, 110],
                "expected": ["重新生成.个词缀技能"]
            }
        }
    },
    "洗词缀V2-普通-验证-十次重构按钮": {
        // 「十次重构」只有普通重构页才有，用来确认没跑错页
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1015, 630, 180, 50],
                "expected": ["十次\\s*重\\s*构"]
            }
        }
    },
    "洗词缀V2-普通-点击-词缀重构": {
        // 实测文字框 base x 741..885 y 642..664 -> 中心 (813, 653)
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [720, 630, 190, 50],
                "expected": ["词缀\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "post_delay": 200
    },

    // ======================================================================
    // 四、定向重构页（模式：词缀锁洗词缀）
    //     说明文字是「锁定的词缀不会被重构…」，右下角只有一个「词缀重构」
    // ======================================================================
    "洗词缀V2-锁-验证-定向重构页签": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1045, 98, 130, 40],
                "expected": ["定向\\s*重\\s*构"]
            }
        }
    },
    "洗词缀V2-锁-验证-培养预览": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [695, 385, 350, 80],
                "expected": ["锁定的词缀"]
            }
        }
    },
    // 上锁状态不靠锁图标判断：锁定的那条不会被重构，所以它在「旧词缀技能」和
    // 「新词缀技能」里文本完全一样 —— 由自定义动作逐行比对认出来，更可靠，
    // 而且顺带证明了“确实锁了一条”（两批全变了就说明根本没锁）。
    "洗词缀V2-锁-点击-词缀重构": {
        // 只有一个按钮时文字框 base x 886..1030 -> 中心 (958, 655)
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [870, 628, 190, 58],
                "expected": ["词缀\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "post_delay": 200
    }
}
