    "未知界面-等待计数": { //PC端专用，在resource_win32里开启。正常加载最多连续空转一百多次，超过300次视为卡在未知界面
        "enabled": false,
        "max_hit": 300
    },
    "未知界面-ESC返回": { //PC端专用，在resource_win32里开启。等待计数用完后按ESC退出未知界面，最多10次；主菜单上误按会被"舰长~真的要退出游戏吗-否"处理
