    "游戏启动-首页等待弹窗": {
        //进首页后多停留几轮:每轮先等一会儿,再重新进"启动并进入游戏"把它那套弹窗处理再跑一遍
        //轮数由任务选项覆盖 max_hit;秒数由任务选项覆盖 repeat
        //等待时长 = repeat 次空动作 × repeat_delay(1000ms) + post_delay(1000ms) = 输入的秒数
        "action": "DoNothing",
        "max_hit": 3,
        "repeat": 5,
        "repeat_delay": 1000,
        "post_delay": 1000,
        "next": [
            "启动并进入游戏"
        ]
    },
