            "战斗相关/战中检查/战后禁用普攻-PC.png"
        ],
        "roi": [
            1155,
            605,
            105,
            115
        ],
        "threshold": 0.80,
        "pre_delay": 0,
        "post_delay": 0
    },
    "角色战斗-生命HUD": {
        "recognition": "OCR",
        "roi": [
            345,
            642,
            525,
            55
